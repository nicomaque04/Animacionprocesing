  pushMatrix (); 
  translate (width / 6 , 5*height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (98, 118, 217);
  box (40);
  popMatrix ();
  
  //fila 5 columna 2
  pushMatrix (); 
  translate (width / 3 , 5*height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
