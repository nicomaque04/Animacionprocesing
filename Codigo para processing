//definicion de valores variables
float angleX1 = 0;
float angleY1 = 0;
float speedX1 = 0.02;
float speedY1 = 0.03;
float rate = 0.0001;  
float maxSpeed = 0.1;  // Velocidad máxima
float minSpeed = 0.01; // Velocidad mínima

float initialAngleXCenter = radians (45);
float initialAngleYCenter = radians (-30);

float initialAngleXExt = radians (135);
float initialAngleYExt = radians (60);

float damping = 0.95;

//Limite de pixeles en pantalla
void setup() {
  size(600, 600, P3D);
}
//funcion que dibuja los cubos
void draw() {
  //Color fondo
  background(0);
  //funcion que hace que no haya vordes en los cubos
  noStroke();
  
  //Cubo enorme
  pushMatrix (); 
  translate (width / 2 , height / 2, 0);      //Posicion del cubo mayor
  rotateX(angleX1 + initialAngleXCenter);     //Rotacion del cubo mayor
  rotateY(angleY1 + initialAngleYCenter);
  drawColoredBox();
  popMatrix ();                               

  //fila 1 columna 1
  pushMatrix (); 
  translate (width / 6 , height / 6, 0);      //posicion del cubo
  rotateX(angleX1 + initialAngleXExt);        //Rotacion del cubo
  rotateY(angleY1 + initialAngleYExt);
  fill (171, 205, 239);                       //color del cubo
  box (40);                                   // medida del Cubo
  popMatrix ();                              //push y pop Matrix son utilizados para encarcelar una funcion y inependizarla en este caso en la creacion de un cubo
  
  //fila 1 columna 2
  pushMatrix (); 
  translate (width / 3 , height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (98, 118, 217);
  box (40);
  popMatrix ();
  
  //fila 1 columna 3
  pushMatrix (); 
  translate (width / 2 , height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (0, 88, 176);
  box (40);
  popMatrix ();
  
  //fila 1 columna 4
  pushMatrix (); 
  translate (2*width / 3 , height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (6, 38, 71);
  box (40);
  popMatrix ();
  
  //fila 1 columna 5
  pushMatrix (); 
  translate (5*width / 6 , height / 6, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (171, 213, 255);
  box (40);
  popMatrix ();
  
  //fila 2 columna 1
  pushMatrix (); 
  translate (width / 6 , height / 3, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (0, 88, 176);
  box (40);
  popMatrix ();
  
  //fila 2 columna 2
  pushMatrix (); 
  translate (width / 3 , height / 3, 0);
  rotateX(angleX1);
  rotateY(angleY1);
  fill (171, 205, 239);
  box (40);
  popMatrix ();
  
  //fila 2 columna 3
  pushMatrix (); 
  translate (width / 2 , height / 3, 0);
  rotateX(angleX1);
  rotateY(angleY1);
  fill (171, 213, 255);
  box (40);
  popMatrix ();
  
  //fila 2 columna 4
  pushMatrix (); 
  translate (2*width / 3 , height / 3, 0);
  rotateX(angleX1);
  rotateY(angleY1);
  fill (0, 12, 69);
  box (40);
  popMatrix ();
  
  //fila 2 columna 5
  pushMatrix (); 
  translate (5*width / 6 , height / 3, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (6, 38, 71);
  box (40);
  popMatrix ();

//fila 3 columna 1
  pushMatrix (); 
  translate (width / 6 , height / 2, 0);
  rotateX(angleX1 + initialAngleXExt);
  rotateY(angleY1 + initialAngleYExt);
  fill (171, 213, 255);
  box (40);
  popMatrix ();
  
  //fila 3 columna 2
  pushMatrix (); 
  translate (width / 3 , height / 2, 0);
  rotateX(angleX1);
  rotateY(angleY1);
  fill (98, 118, 217);
  box (40);
  popMatrix ();
  
  //fila 3 columna 3
  pushMatrix (); 
  translate (width / 2 , height / 2, 0);
  rotateX(angleX1 + initialAngleXCenter);
  rotateY(angleY1 + initialAngleYCenter);
  fill (171, 205, 239);
  box (40);
  popMatrix ();
  
  //fila 3 columna 4
  pushMatrix (); 
  translate (2*width / 3 , height / 2, 0);
  rotateX(angleX1);
