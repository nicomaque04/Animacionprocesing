  rotateY(angleY1 + initialAngleYExt);
  fill (6, 38, 71);
  box (40);
  popMatrix ();

  //Velocidad
  angleX1 += speedX1;
  angleY1 += speedY1;
  
  // Aplicar amortiguación para reducir la velocidad gradualmente
  speedX1 *= damping;
  speedY1 *= damping;
  
  // Limitar la velocidad máxima y mínima
  speedX1 = constrain(speedX1, minSpeed, maxSpeed);
  speedY1 = constrain(speedY1, minSpeed, maxSpeed);
}

//Movimiento del mouse
void mouseDragged() {
  float dx = mouseX - pmouseX;
  float dy = mouseY - pmouseY;

  // Modificar la velocidad basándonos en el movimiento del mouse
  speedX1 += dy * 0.005;
  speedY1 += dx * 0.005;
}

void drawColoredBox() {
  float boxSize = 5000;

  // Color cara frontal (celeste)
  fill(171, 213, 255);
  beginShape();                                            //Inicio de dibujo de la figura 
  vertex(-boxSize / 2, -boxSize / 2, -boxSize / 2);        //Posicion de las caras
  vertex(boxSize / 2, -boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, -boxSize / 2);
  vertex(-boxSize / 2, boxSize / 2, -boxSize / 2);
  endShape(CLOSE);                                         //Final de dibujo de la figura

  // Color cara posterior (hielo)
  fill(171, 205, 239);
  beginShape();
  vertex(-boxSize / 2, -boxSize / 2, boxSize / 2);
  vertex(boxSize / 2, -boxSize / 2, boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, boxSize / 2);
  vertex(-boxSize / 2, boxSize / 2, boxSize / 2);
  endShape(CLOSE);

  // Color cara superior (azulado)
  fill(0, 88, 176);
  beginShape();
  vertex(-boxSize / 2, -boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, -boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, -boxSize / 2, boxSize / 2);
  vertex(-boxSize / 2, -boxSize / 2, boxSize / 2);
  endShape(CLOSE);

  // Color cara inferior (azul oscuro)
  fill(6, 38, 71);
  beginShape();
  vertex(-boxSize / 2, boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, boxSize / 2);
  vertex(-boxSize / 2, boxSize / 2, boxSize / 2);
  endShape(CLOSE);

  // Color cara izquierda (alilado)
  fill(98, 118, 217);
  beginShape();
  vertex(-boxSize / 2, -boxSize / 2, -boxSize / 2);
  vertex(-boxSize / 2, boxSize / 2, -boxSize / 2);
  vertex(-boxSize / 2, boxSize / 2, boxSize / 2);
  vertex(-boxSize / 2, -boxSize / 2, boxSize / 2);
  endShape(CLOSE);

  // Color cara derecha (alilado oscuro)
  fill(0, 12, 69);
  beginShape();
  vertex(boxSize / 2, -boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, -boxSize / 2);
  vertex(boxSize / 2, boxSize / 2, boxSize / 2);
  vertex(boxSize / 2, -boxSize / 2, boxSize / 2);
  endShape(CLOSE);
}

